# Copy this file to `.streamlit/secrets.toml` and keep only the entries
# needed by the profile you run.
# Never commit the real secrets.toml file.

# Local paid mode only:
OPENAI_API_KEY = "replace-with-your-openai-api-key"

# Streamlit cloud profile only:
CLOUDFLARE_ACCOUNT_ID = "replace-with-your-32-character-account-id"
CLOUDFLARE_API_TOKEN = "replace-with-your-workers-ai-api-token"
